{
  "name": "mcsr-rank-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop companion for public MCSR Ranked statistics.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mcsrrank.desktop",
    "productName": "MCSR Rank",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/branding/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
